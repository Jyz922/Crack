# DoubleTake Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# Safety switch to allow live LLM calls (prevents unintended charges)
DOUBLETAKE_ALLOW_LIVE=1

# Backend selection: auto, gemini, openai, deepseek, anthropic, etc.
# Default is 'auto' (detects whichever key you provide automatically)
DOUBLETAKE_BACKEND=auto

# ---------------------------------------------------------------------------
# API Keys (fill in whichever you have available):
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPUAI_API_KEY=
# SILICONFLOW_API_KEY=
